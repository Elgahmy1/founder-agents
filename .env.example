# Copy to .env to override defaults. No keys are needed: everything runs locally for free.
MODEL=qwen3:8b
OLLAMA_URL=http://localhost:11434
LLM_TIMEOUT_S=600
WEB_RESEARCH=1
MAX_SOURCES=8
DATA_DIR=./data
OUTPUTS_DIR=./outputs
DECISION_LOG=./decision_log.json
PUBLIC_BASE_URL=http://localhost:8000

# Optional: no GPU? Use an OpenAI-compatible FREE tier that serves open-weight models.
# Example (Groq free tier, open-weight gpt-oss): get a free key at https://console.groq.com/keys
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=your-free-key-here
# MODEL=openai/gpt-oss-120b
LLM_PROVIDER=ollama
